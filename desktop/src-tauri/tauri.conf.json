{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOVA Chat",
  "version": "0.1.0",
  "identifier": "com.nova.chat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NOVA Chat",
        "width": 1080,
        "height": 780,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; font-src 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../runtime/windows/llama-cpp/llama-server.exe": "runtime/windows/llama-cpp/llama-server.exe",
      "../../runtime/windows/llama-cpp/llama-server-impl.dll": "runtime/windows/llama-cpp/llama-server-impl.dll",
      "../../runtime/windows/llama-cpp/llama.dll": "runtime/windows/llama-cpp/llama.dll",
      "../../runtime/windows/llama-cpp/llama-common.dll": "runtime/windows/llama-cpp/llama-common.dll",
      "../../runtime/windows/llama-cpp/mtmd.dll": "runtime/windows/llama-cpp/mtmd.dll",
      "../../runtime/windows/llama-cpp/ggml.dll": "runtime/windows/llama-cpp/ggml.dll",
      "../../runtime/windows/llama-cpp/ggml-base.dll": "runtime/windows/llama-cpp/ggml-base.dll",
      "../../runtime/windows/llama-cpp/ggml-cuda.dll": "runtime/windows/llama-cpp/ggml-cuda.dll",
      "../../runtime/windows/llama-cpp/ggml-cpu-alderlake.dll": "runtime/windows/llama-cpp/ggml-cpu-alderlake.dll",
      "../../runtime/windows/llama-cpp/ggml-cpu-cannonlake.dll": "runtime/windows/llama-cpp/ggml-cpu-cannonlake.dll",
      "../../runtime/windows/llama-cpp/ggml-cpu-cascadelake.dll": "runtime/windows/llama-cpp/ggml-cpu-cascadelake.dll",
      "../../runtime/windows/llama-cpp/ggml-cpu-cooperlake.dll": "runtime/windows/llama-cpp/ggml-cpu-cooperlake.dll",
      "../../runtime/windows/llama-cpp/ggml-cpu-haswell.dll": "runtime/windows/llama-cpp/ggml-cpu-haswell.dll",
      "../../runtime/windows/llama-cpp/ggml-cpu-icelake.dll": "runtime/windows/llama-cpp/ggml-cpu-icelake.dll",
      "../../runtime/windows/llama-cpp/ggml-cpu-ivybridge.dll": "runtime/windows/llama-cpp/ggml-cpu-ivybridge.dll",
      "../../runtime/windows/llama-cpp/ggml-cpu-piledriver.dll": "runtime/windows/llama-cpp/ggml-cpu-piledriver.dll",
      "../../runtime/windows/llama-cpp/ggml-cpu-sandybridge.dll": "runtime/windows/llama-cpp/ggml-cpu-sandybridge.dll",
      "../../runtime/windows/llama-cpp/ggml-cpu-sapphirerapids.dll": "runtime/windows/llama-cpp/ggml-cpu-sapphirerapids.dll",
      "../../runtime/windows/llama-cpp/ggml-cpu-skylakex.dll": "runtime/windows/llama-cpp/ggml-cpu-skylakex.dll",
      "../../runtime/windows/llama-cpp/ggml-cpu-sse42.dll": "runtime/windows/llama-cpp/ggml-cpu-sse42.dll",
      "../../runtime/windows/llama-cpp/ggml-cpu-x64.dll": "runtime/windows/llama-cpp/ggml-cpu-x64.dll",
      "../../runtime/windows/llama-cpp/ggml-cpu-zen4.dll": "runtime/windows/llama-cpp/ggml-cpu-zen4.dll",
      "../../runtime/windows/llama-cpp/libomp.dll": "runtime/windows/llama-cpp/libomp.dll",
      "../../runtime/windows/llama-cpp/cudart64_12.dll": "runtime/windows/llama-cpp/cudart64_12.dll",
      "../../runtime/windows/llama-cpp/cublas64_12.dll": "runtime/windows/llama-cpp/cublas64_12.dll",
      "../../runtime/windows/llama-cpp/cublasLt64_12.dll": "runtime/windows/llama-cpp/cublasLt64_12.dll",
      "../../runtime/windows/llama-cpp/LICENSE-LLVM-OpenMP": "runtime/windows/llama-cpp/LICENSE-LLVM-OpenMP"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
